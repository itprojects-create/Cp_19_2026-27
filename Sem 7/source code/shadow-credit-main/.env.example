# ══════════════════════════════════════════════
# Shadow Credit — Environment Variables
# ══════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ── Database ──
SQLITE_DB_PATH=./data/shadow_credit.db

# ── Security ──
ENCRYPTION_KEY=CHANGE_ME_TO_A_64_HEX_CHAR_AES_256_KEY
HMAC_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# ── AI Provider ──
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── CORS ──
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate Limiting ──
RATE_LIMIT_DEFAULT=100/minute
