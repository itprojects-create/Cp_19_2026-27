# ═══════════════════════════════════════════════════════════════
# SHADOW CREDIT — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════════════════

# ── Encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=your_master_encryption_key_here

# ── AI APIs
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
SUPERVISOR_REASONING_PROVIDER=rule_based
ANTHROPIC_API_KEY=

# ── Google APIs
GOOGLE_VISION_CREDENTIALS_PATH=
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MAPS_PROVIDER=osm
MAPS_USER_AGENT=ShadowCredit/1.0

# ── Database
# Absolute path is strongly recommended. Relative paths are resolved
# relative to the project root by config.py's field_validator.
# You can leave this commented out to use the safe absolute default in config.py.
DATABASE_PATH=../data/shadow_credit.db

# ── App Config
DEBUG=true
ENVIRONMENT=development
USE_GPU=false
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── OCR
OCR_CONFIDENCE_THRESHOLD=0.60
ENABLE_EASYOCR_FALLBACK=true
EASYOCR_LANGS=en,hi
EASYOCR_GPU=false
ENABLE_GOOGLE_VISION_FALLBACK=false
ENABLE_TESSERACT_FALLBACK=false
# Windows example: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
TESSERACT_LANGS=eng+hin

# ── Confidence thresholds
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.50

# ── Credit formula
CREDIT_MULTIPLIER=3.0
CREDIT_CAP_WITHOUT_AA=300000
CREDIT_CAP_WITH_AA=1000000
